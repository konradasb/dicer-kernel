# What Dicer needs from a guest kernel, on top of Cloud Hypervisor's
# configuration in configs/. build.sh fails if any of it does not survive
# into the kernel's final configuration.

# Images are booted from EROFS disks, compressed with LZ4.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# The instance's own disk is laid over the image with overlayfs.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y

# dicer exec, dicer cp and health checks reach the guest over vsock.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Containers inside a guest, such as a CI runner's Docker: bridges and NAT,
# through iptables' legacy tables, which Linux 6.17 split out.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_BRIDGE=y

# What else Docker's check-config.sh calls generally necessary: the matches
# and tables its bridge network is built from. IPv4 only, as the kernel has
# no IPv6 and Dicer's networks none either; Docker only warns without it.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_NF_RAW=y

# The kernel's configuration, readable in the guest at /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# dicer-init sets the hostname; this is only what it is before.
CONFIG_DEFAULT_HOSTNAME="dicer"
